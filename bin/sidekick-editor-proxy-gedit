#!/usr/bin/env bash
set -euo pipefail

# $EDITOR proxy: open $1 in the host Neovim ($NVIM) and block until the buffer closes.
#
# The `-gedit` suffix is deliberate. Claude Code clears its screen (alternate screen)
# before running a terminal editor, but leaves it visible for GUI editors, which it
# detects by a substring match of the editor's basename against names like `gedit`.
# Looking like gedit keeps Claude's conversation on screen while the prompt is edited
# in Neovim. Unlike `code`/`subl`, gedit gets no extra `-g file:line` arguments.

# A native pane keeps the environment of its first host. Sidekick updates this
# per-pane endpoint whenever a new Neovim attaches to the running agent.
if [[ -n "${HERDR_PANE_ID:-}" ]]; then
	socket_key=${HERDR_SOCKET_PATH:-default}
	socket_key=${socket_key//[^a-zA-Z0-9_.-]/_}
	pane_key=${HERDR_PANE_ID//[^a-zA-Z0-9_.-]/_}
	host_file="${XDG_CACHE_HOME:-$HOME/.cache}/sidekick/editor-hosts/$socket_key/$pane_key"
	if [[ -r "$host_file" ]]; then
		{
			IFS= read -r NVIM
			IFS= read -r SIDEKICK_NVIM
		} < "$host_file"
	fi
fi

if [[ -z "${NVIM:-}" ]]; then
	printf 'sidekick-editor-proxy: NVIM is empty; cannot reach the host Neovim\n' >&2
	exit 1
fi

if [[ $# -lt 1 || -z "$1" ]]; then
	printf 'sidekick-editor-proxy: missing file path\n' >&2
	exit 1
fi

FILE="$1"

PIPE="$(mktemp -u "${TMPDIR:-/tmp}/sidekick-editor-proxy.XXXXXX")"
mkfifo "$PIPE"
trap 'rm -f "$PIPE"' EXIT

vim_quote() {
	# Vim single-quoted string: only "'" is special, doubled to "''".
	local s=$1
	s=${s//\'/\'\'}
	printf "'%s'" "$s"
}

# HERDR_PANE_ID is the caller's pane, so Neovim can focus itself and hand focus back on close.
expr="v:lua.require('KoalaVim.utils.ai.general').open_editor_file($(vim_quote "$FILE"), $(vim_quote "$PIPE"), $(vim_quote "${HERDR_PANE_ID:-}"))"

if ! remote_out=$("${SIDEKICK_NVIM:-nvim}" --server "$NVIM" --remote-expr "$expr" 2>&1); then
	printf 'sidekick-editor-proxy: nvim --remote-expr failed (NVIM=%s): %s\n' "$NVIM" "$remote_out" >&2
	exit 1
fi

# Neovim writes a byte to unblock; read returns non-zero on EOF without a newline.
read < "$PIPE" || true
exit 0
