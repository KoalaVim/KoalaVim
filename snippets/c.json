{
  "attribute": {
    "prefix": "attribute",
    "description": "__attribute__",
    "body": [
      "__attribute__((${1}))$0"
    ]
  },
  "headerguard": {
    "prefix": "headerguard",
    "description": "Header include guard",
    "body": [
      "#ifndef ${TM_FILENAME_BASE}_H_",
      "#define ${TM_FILENAME_BASE}_H_",
      "",
      "${0}",
      "",
      "#endif // ${TM_FILENAME_BASE}_H_"
    ]
  },
  "ifdefcpp": {
    "prefix": "ifdefcpp",
    "description": "Disable C++ name mangling in C headers",
    "body": [
      "#ifdef __cplusplus",
      "extern \"C\" {",
      "#endif",
      "",
      "${0}",
      "",
      "#ifdef __cplusplus",
      "} // extern \"C\"",
      "#endif"
    ]
  },
  "pack": {
    "prefix": "pack",
    "description": "Pragma pack and pop",
    "body": [
      "#pragma pack(push, 1)",
      "",
      "$0",
      "",
      "#pragma pack(pop)"
    ]
  },
  "refrencedarray": {
    "prefix": "refrencedarray",
    "description": "Referenced array",
    "body": [
      "${3:uint8_t} (&${1:array})[${2:len}]$0"
    ]
  },
  "reinterpretcast": {
    "prefix": "reinterpretcast",
    "description": "reinterpret_cast",
    "body": [
      "reinterpret_cast<${2:uint8_t*}>($1)$0"
    ]
  },
  "clas": {
    "prefix": "clas",
    "description": "class",
    "body": [
      "class ${TM_FILENAME_BASE}",
      "{",
      "public:",
      "\t${TM_FILENAME_BASE}(${1}) ${2:= default;}",
      "\t~${TM_FILENAME_BASE}() ${3:= default;}",
      "\t$0",
      "};"
    ]
  },
  "if": {
    "prefix": "if",
    "description": "if",
    "body": [
      "if (${1:true})",
      "{",
      "\t${0}",
      "}"
    ]
  },
  "ife": {
    "prefix": "ife",
    "description": "if/else",
    "body": [
      "if (${1:true})",
      "{",
      "\t${2}",
      "}",
      "else",
      "{",
      "\t${0}",
      "}"
    ]
  },
  "el": {
    "prefix": "el",
    "description": "else",
    "body": [
      "else",
      "{",
      "\t${0}",
      "}"
    ]
  },
  "elif": {
    "prefix": "elif",
    "description": "else if",
    "body": [
      "else if (${1:true})",
      "{",
      "\t${0}",
      "}"
    ]
  },
  "switch": {
    "prefix": "switch",
    "description": "switch",
    "body": [
      "switch (${1:/* variable */})",
      "{",
      "\tcase ${2:/* variable case */}:",
      "\t\t${3}",
      "\t\t${4:break;}${5}",
      "\tdefault:",
      "\t\t${6}",
      "}"
    ]
  },
  "for": {
    "prefix": "for",
    "description": "for loop",
    "body": [
      "for (int ${1:i} = 0; $1 < ${2:count}; $1${3:++})",
      "{",
      "\t${0}",
      "}"
    ]
  },
  "wh": {
    "prefix": "wh",
    "description": "while",
    "body": [
      "while (${1:/* condition */})",
      "{",
      "\t${0}",
      "}"
    ]
  }
}
