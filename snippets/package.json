{
  "name": "koalavim-snippets",
  "description": "KoalaVim snippets (VSCode format, loaded by nvim-snippets)",
  "contributes": {
    "snippets": [
      {
        "language": [
          "c",
          "cpp"
        ],
        "path": "./c.json"
      },
      {
        "language": "go",
        "path": "./go.json"
      },
      {
        "language": "lua",
        "path": "./lua.json"
      },
      {
        "language": "python",
        "path": "./python.json"
      },
      {
        "language": "rust",
        "path": "./rust.json"
      },
      {
        "language": "yaml",
        "path": "./yaml.json"
      }
    ]
  }
}
